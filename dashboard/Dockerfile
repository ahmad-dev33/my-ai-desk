FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_BRAND_NAME
ARG VITE_BRAND_PRIMARY
ARG VITE_BASE_DOMAIN
ARG VITE_PUBLIC_SCHEME
ARG VITE_PUBLIC_PORT_SUFFIX
ARG VITE_API_URL
ENV VITE_BRAND_NAME=$VITE_BRAND_NAME \
    VITE_BRAND_PRIMARY=$VITE_BRAND_PRIMARY \
    VITE_BASE_DOMAIN=$VITE_BASE_DOMAIN \
    VITE_PUBLIC_SCHEME=$VITE_PUBLIC_SCHEME \
    VITE_PUBLIC_PORT_SUFFIX=$VITE_PUBLIC_PORT_SUFFIX \
    VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.29-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
