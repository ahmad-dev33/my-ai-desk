# Public DNS. Create A/AAAA records for dashboard, api, inbox, flows, bot, auth, hooks and assets.
BASE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
PUBLIC_SCHEME=https
PUBLIC_PORT_SUFFIX=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true
CHATWOOT_FORCE_SSL=true
# Optional temporary public URL for Meta OAuth/webhooks during local development (for example, ngrok).
CHATWOOT_FRONTEND_URL=
S3_PUBLIC_PORT=443
S3_PUBLIC_SSL=true
BRAND_NAME=My AI Desk
BRAND_PRIMARY=#635BFF

# Pinned application images (upgrade deliberately).
CHATWOOT_VERSION=v4.16.2-ce
TYPEBOT_VERSION=3.17.2
KEYCLOAK_VERSION=26.6.3

# Generate strong alphanumeric values with scripts/bootstrap.ps1 or bootstrap.sh.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
REDIS_PASSWORD=CHANGE_ME_REDIS
CHATWOOT_SECRET_KEY_BASE=CHANGE_ME_64_ALPHANUMERIC_CHARACTERS
CHATWOOT_ACTIVE_RECORD_PRIMARY_KEY=CHANGE_ME_32_ALPHANUMERIC
CHATWOOT_ACTIVE_RECORD_DETERMINISTIC_KEY=CHANGE_ME_32_ALPHANUMERIC
CHATWOOT_ACTIVE_RECORD_SALT=CHANGE_ME_32_ALPHANUMERIC
TYPEBOT_ENCRYPTION_SECRET=CHANGE_ME_32_ALPHANUMERIC
MINIO_ROOT_USER=unifiedadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
KEYCLOAK_USER_EMAIL=admin@example.com
KEYCLOAK_USER_PASSWORD=CHANGE_ME_KEYCLOAK_USER
KEYCLOAK_TYPEBOT_CLIENT_SECRET=CHANGE_ME_TYPEBOT_OIDC
WEBHOOK_SHARED_SECRET=CHANGE_ME_WEBHOOK
# Use a different secret in production; the webhook secret is only a development fallback.
BRIDGE_SERVICE_SECRET=CHANGE_ME_BRIDGE_SERVICE_SECRET

# Chatwoot user/profile API token with access to the target accounts.
CHATWOOT_API_TOKEN=CHANGE_ME_AFTER_FIRST_LOGIN
# Optional tenant-safe override: {"1":"token-for-account-1","2":"token-for-account-2"}
CHATWOOT_TOKENS_JSON={}
# Maps a channel connection credential_ref to a Chatwoot token without storing secrets in PostgreSQL.
BRIDGE_CREDENTIALS_JSON={}

# Bootstrap admin. Disable public sign-up after provisioning.
TYPEBOT_ADMIN_EMAIL=admin@example.com
TYPEBOT_DISABLE_SIGNUP=false

# SMTP shared by Chatwoot and Typebot.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=My AI Desk <no-reply@example.com>
SMTP_SECURE=false
